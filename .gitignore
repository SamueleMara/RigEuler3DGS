patches/

# Submodules are excluded, with one exception. diff-gaussian-rasterization is
# no longer a submodule: it carries this project's own CUDA kernels (the IEKF
# forward/backward passes and the grouped variant), so its sources are tracked
# here directly. Its third_party/glm checkout stays out -- 1530 unmodified
# upstream files and 23 MB -- and remains a plain git clone on disk.
SIBR_viewers/
submodules/*
!submodules/diff-gaussian-rasterization/
submodules/diff-gaussian-rasterization/third_party/
submodules/diff-gaussian-rasterization/build/
submodules/diff-gaussian-rasterization/dist/
submodules/diff-gaussian-rasterization/*.egg-info/

# Run artifacts written INTO the source tree by tests and tools. These are
# generated, not authored -- tests/tiny_diffusion_test/ alone is 11 MB of
# checkpoints and diagnostic PNGs produced by tests/tiny_video_diffusion_test.py.
tests/tiny_diffusion_test/
tests/**/*.pt
tests/**/*.pth
tests/**/*.zip
tests/**/*.npy
tests/**/*.ply
tests/**/diagnostics/

# Task specs written for a run, not part of the published code.
CODEX_*.md

# machine-produced test logs; the ledger json/md are committed, the raw logs are not
docs/test_ledger_logs/

# visibility-constraint extension build directory
submodules/diff-gaussian-rasterization/build_vis/

# retired code, kept on disk only
attic/
# written by tests/test_exact_cached_structured_backend.py on every run
docs/FUSED_PHASE1_EXACT_ACCELERATION_EQUIVALENCE_tests.json
